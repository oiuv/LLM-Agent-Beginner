{
  "name": "llm-agent-beginner",
  "version": "1.0.0",
  "description": "从零开发完整指导学习 Agent 的工程教程",
  "private": true,
  "workspaces": [
    "examples/learning-agent-runtime"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:runtime",
    "test:all": "npm run test:runtime && npm run check:docs && npm run check:plugins",
    "tutorial": "npm --workspace @tutorial/learning-agent-runtime run demo",
    "test:runtime": "npm --workspace @tutorial/learning-agent-runtime test",
    "demo": "npm run tutorial",
    "weather-server": "npm --prefix examples/weather-mcp run start",
    "github-server": "npm --prefix examples/github-mcp run start",
    "client-example": "npm --prefix examples/mcp-client run demo",
    "demo:mcp": "npm --prefix examples/mcp-assistant run start",
    "tutorial:patterns": "npm --workspace @tutorial/learning-agent-runtime run patterns",
    "check:docs": "node scripts/check-docs.mjs",
    "tutorial:hooks": "npm --workspace @tutorial/learning-agent-runtime run hooks",
    "check:plugins": "node scripts/check-plugins.mjs",
    "test:plugin-mcp": "uv run --project examples/mcp-http python scripts/check-plugin-mcp.py"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ajv": "^8.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "agent",
    "skills",
    "llm",
    "tutorial"
  ],
  "license": "MIT"
}
